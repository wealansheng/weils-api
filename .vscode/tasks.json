{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "weils: prepare Windows directories",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tool/run_windows.ps1",
        "-PrepareOnly"
