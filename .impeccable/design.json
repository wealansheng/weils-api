  "narrative": {
    "northStar": "浅色蓝灰 API 工作台",
    "overview": "A clean, restrained Windows desktop API tool. White work areas sit inside a cool-gray shell; slate text, pale-blue selection and cobalt actions keep the request and response legible together. The confirmed visual language is practical and compact.\n\nMicrosoft YaHei and the Windows fallback stack serve Chinese UI text; Consolas separates URLs, methods and response content. Density comes from short rows and thin separators rather than decorative cards. This records the shipped Flutter implementation, with no new visual identity.",
    "keyCharacteristics": [
      "White workspace and cool-gray shell.",
      "Pale-blue selection with cobalt action and active-state cues.",
      "Compact desktop controls, thin borders and readable code."
    ],
    "rules": [
      {
        "name": "Selection and Action",
        "body": "Use pale blue for selected surfaces and cobalt for actions, active labels and tab underlines.",
        "section": "colors"
      },
      {
        "name": "UI and Code",
        "body": "Keep the Windows UI stack for interface text and Consolas for code content and method labels.",
        "section": "typography"
      },
      {
        "name": "Flat Workspace",
        "body": "Separate persistent work areas with tone and thin borders; primary buttons have zero elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing white, shell, selection and line roles for pane hierarchy.",
      "Do keep request and response together and allow code content to scroll in both axes.",
      "Do pair status and method colors with readable text labels.",
      "Do retain the confirmed Chinese navigation and utility labels."
    ],
    "donts": [
      "Don't introduce branch or environment controls, extra rail destinations, or extra shell utility entries.",
      "Don't replace the confirmed blue-gray palette with the discarded warm or purple directions.",
      "Don't promote screenshot sample requests, response metrics or generated preview ramps into product defaults."
    ]
  }
